---
import Layout from '../layouts/Layout.astro';
import CloudflareProduct from '../components/CloudflareProduct.astro';
import { Icon } from 'astro-icon/components';
import data from '../data.json';

const { apps, summary, lastUpdated, totalApps } = data;

// Sort apps by shipped date (newest first)
const sortedApps = [...apps].sort(
  (a, b) => new Date(b.shippedDate).getTime() - new Date(a.shippedDate).getTime()
);

// Get sorted products by frequency
const sortedProducts = Object.entries(summary.cloudflareProducts)
  .sort((a, b) => b[1] - a[1]);

// Get sorted frameworks
const sortedFrameworks = Object.entries(summary.byFramework)
  .sort((a, b) => b[1] - a[1]);

// Get sorted build tools and package managers
const sortedBuildTools = Object.entries(summary.byBuildTool).sort((a, b) => b[1] - a[1]);
const sortedPackageManagers = Object.entries(summary.byPackageManager).sort((a, b) => b[1] - a[1]);

// Get contributor counts
const authorCounts = new Map();
for (const app of apps) {
  const existing = authorCounts.get(app.author.github);
  if (existing) {
    existing.count++;
  } else {
    authorCounts.set(app.author.github, {
      name: app.author.name,
      github: app.author.github,
      avatar: app.author.avatar,
      count: 1,
    });
  }
}
const sortedAuthors = [...authorCounts.values()].sort((a, b) => b.count - a.count);

// Apps using Replicate
const replicateApps = apps.filter((app) => app.replicate.usesReplicate);

// Products missing from Garden
const productsInGarden = new Set(Object.keys(summary.cloudflareProducts));
const allCloudflareProducts = [
  { name: "Queues", description: "Message queues without egress fees", ideas: "Background job processor, webhook relay" },
  { name: "Vectorize", description: "Vector database for AI/ML", ideas: "Semantic search, RAG chatbot" },
  { name: "Stream", description: "Video storage/encoding/delivery", ideas: "Video hosting, live streaming" },
  { name: "Pipelines", description: "Real-time data ingestion to R2", ideas: "Analytics collector, log aggregator" },
  { name: "Email Routing", description: "Create/manage email addresses", ideas: "Contact form handler" },
  { name: "Turnstile", description: "CAPTCHA alternative", ideas: "Bot protection demo" },
  { name: "Browser Rendering", description: "Headless browser control", ideas: "Screenshot service, PDF generator" },
  { name: "Containers", description: "Serverless containers", ideas: "Long-running jobs, legacy app migration" },
  { name: "Agents", description: "AI agents with persistence", ideas: "AI assistant with memory" },
  { name: "AI Search", description: "Managed RAG pipelines", ideas: "Documentation Q&A" },
  { name: "Waiting Room", description: "Traffic queue management", ideas: "Event ticket sales, product launch" },
  { name: "Web Analytics", description: "Privacy-first analytics", ideas: "Analytics dashboard" },
  { name: "Zaraz", description: "Third-party tool manager", ideas: "Tag management demo" },
  { name: "Load Balancing", description: "Traffic distribution", ideas: "Multi-region app demo" },
  { name: "Pub/Sub", description: "Real-time messaging", ideas: "Chat app, notifications" },
];
const missingProducts = allCloudflareProducts.filter(p => !productsInGarden.has(p.name));
---

<Layout title="Small App Garden">
  <header class="mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Small App Garden</h1>
    <p class="text-xl text-gray-600 mb-6">
      A curated collection of <strong class="text-orange-600">{totalApps} apps</strong> built on Cloudflare's developer platform.
    </p>
    
    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900">{totalApps}</div>
        <div class="text-sm text-gray-500">Apps</div>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900">{summary.testing.withTests}</div>
        <div class="text-sm text-gray-500">With Tests ({Math.round((summary.testing.withTests / totalApps) * 100)}%)</div>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900">{summary.ci.withGitHubActions}</div>
        <div class="text-sm text-gray-500">With CI ({Math.round((summary.ci.withGitHubActions / totalApps) * 100)}%)</div>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900">{summary.replicate.appsUsingReplicate}</div>
        <div class="text-sm text-gray-500">Use Replicate ({Math.round((summary.replicate.appsUsingReplicate / totalApps) * 100)}%)</div>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900">{summary.wrangler.compatibilityDateGteFirstCommit}</div>
        <div class="text-sm text-gray-500">Compat Date OK ({Math.round((summary.wrangler.compatibilityDateGteFirstCommit / Math.max(summary.wrangler.withWranglerConfig, 1)) * 100)}%)</div>
      </div>
    </div>
  </header>

  <!-- Apps Table -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Apps</h2>
    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-visible">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  App
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    GitHub repository
                  </span>
                </span>
              </th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  Framework
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Detected framework
                  </span>
                </span>
              </th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center justify-center group">
                  Tests
                  <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Repo contains test files
                  </span>
                </span>
              </th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center justify-center group">
                  CI
                  <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Uses GitHub Actions
                  </span>
                </span>
              </th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center justify-center group">
                  Compat
                  <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Current Workers compatibility_date (>= first commit date)
                  </span>
                </span>
              </th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  Cloudflare Products
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Detected from wrangler config and Garden tags
                  </span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedApps.map((app) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <a href={app.github} class="text-orange-600 hover:underline font-medium" target="_blank" rel="noopener">
                    {app.name}
                  </a>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600">
                  {typeof app.stack.framework === 'string' ? app.stack.framework.replace(/\s+\d+$/, '') : 'Multiple'}
                </td>
                <td class="px-4 py-3 text-center">
                  {app.testing.hasTests && (
                    <span class="relative inline-flex items-center justify-center group" aria-label="Has tests">
                      <Icon name="lucide:check" class="w-5 h-5 text-green-500 inline" />
                      <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                        Tests detected
                      </span>
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-center">
                  {app.ci.hasGitHubActions && (
                    <span class="relative inline-flex items-center justify-center group" aria-label="Has CI">
                      <Icon name="lucide:check" class="w-5 h-5 text-green-500 inline" />
                      <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                        GitHub Actions detected
                      </span>
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-center">
                  {app.cloudflare.hasWranglerConfig ? (
                    app.cloudflare.compatibilityDateGteFirstCommit ? (
                      <span class="relative inline-flex items-center justify-center group" aria-label="Compatibility date OK">
                        <Icon name="lucide:check" class="w-5 h-5 text-green-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          compatibility_date is recent enough
                        </span>
                      </span>
                    ) : (
                      <span class="relative inline-flex items-center justify-center group" aria-label="Compatibility date not OK">
                        <Icon name="lucide:x" class="w-5 h-5 text-red-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          compatibility_date missing or older than first commit
                        </span>
                      </span>
                    )
                  ) : (
                    <span class="relative inline-flex items-center justify-center group text-gray-300" aria-label="No wrangler config">
                      -
                      <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                        No wrangler config detected
                      </span>
                    </span>
                  )}
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-1 flex-wrap">
                    {app.cloudflare.products.map((product) => (
                      <CloudflareProduct product={product} />
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Cloudflare Products & Opportunities (grouped together) -->
  <div class="grid md:grid-cols-2 gap-8 mb-12">
    <!-- Cloudflare Products -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Cloudflare Products</h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-visible">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  Product
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Cloudflare product
                  </span>
                </span>
              </th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center justify-center group">
                  Count
                  <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Number of apps using it
                  </span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedProducts.map(([product, count]) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <CloudflareProduct product={product} />
                    <span class="text-sm text-gray-700">{product}</span>
                  </div>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-600">{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Opportunities -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Opportunities</h2>
      <p class="text-sm text-gray-600 mb-4">Cloudflare products not yet represented in the Garden:</p>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
        <div class="divide-y divide-gray-100 max-h-96 overflow-y-auto">
          {missingProducts.map((product) => (
            <div class="px-4 py-3 hover:bg-gray-50">
              <a 
                href={`https://developers.cloudflare.com/${product.name.toLowerCase().replace(/\s+/g, "-")}`}
                class="font-medium text-orange-600 hover:underline"
                target="_blank"
                rel="noopener"
              >
                {product.name}
              </a>
              <p class="text-sm text-gray-600">{product.description}</p>
              <p class="text-xs text-gray-400 mt-1">Ideas: {product.ideas}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Replicate Models -->
  {replicateApps.length > 0 && (
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Replicate Models</h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-visible">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  App
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    GitHub repository
                  </span>
                </span>
              </th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  Models
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Replicate models referenced in code
                  </span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {replicateApps.map((app) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <a href={app.github} class="text-orange-600 hover:underline font-medium" target="_blank" rel="noopener">
                    {app.name}
                  </a>
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-2 flex-wrap">
                    {app.replicate.models.length > 0 ? (
                      app.replicate.models.map((model) => (
                        <a 
                          href={`https://replicate.com/${model}`}
                          class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded hover:bg-gray-200"
                          target="_blank"
                          rel="noopener"
                        >
                          {model}
                        </a>
                      ))
                    ) : (
                      <span class="text-gray-400 text-sm">-</span>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Frameworks & Build Tools -->
  <div class="grid md:grid-cols-2 gap-8 mb-12">
    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Frameworks</h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-visible">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center group">
                  Framework
                  <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Detected framework
                  </span>
                </span>
              </th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                <span class="relative inline-flex items-center justify-center group">
                  Count
                  <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                    Number of apps
                  </span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedFrameworks.map(([framework, count]) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm text-gray-700">{framework}</td>
                <td class="px-4 py-3 text-center text-sm text-gray-600">{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Build Tools & Package Managers</h2>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
          <div class="bg-gray-50 border-b border-gray-200 px-4 py-2">
            <span class="text-sm font-semibold text-gray-700">Build Tools</span>
          </div>
          <div class="divide-y divide-gray-100">
            {sortedBuildTools.map(([tool, count]) => (
              <div class="flex justify-between px-4 py-2 hover:bg-gray-50">
                <span class="text-sm text-gray-700">{tool}</span>
                <span class="text-sm text-gray-500">{count}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
          <div class="bg-gray-50 border-b border-gray-200 px-4 py-2">
            <span class="text-sm font-semibold text-gray-700">Package Managers</span>
          </div>
          <div class="divide-y divide-gray-100">
            {sortedPackageManagers.map(([pm, count]) => (
              <div class="flex justify-between px-4 py-2 hover:bg-gray-50">
                <span class="text-sm text-gray-700">{pm}</span>
                <span class="text-sm text-gray-500">{count}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Repository Hygiene -->
  {summary.hygiene && (
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Repository Hygiene</h2>
      
      <!-- Summary Stats -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100 text-center">
          <div class="text-2xl font-bold text-gray-900">{summary.hygiene.withDescription}</div>
          <div class="text-xs text-gray-500">Has Description</div>
          <div class="text-xs text-gray-400">{Math.round((summary.hygiene.withDescription / totalApps) * 100)}%</div>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100 text-center">
          <div class="text-2xl font-bold text-gray-900">{summary.hygiene.withWebsite}</div>
          <div class="text-xs text-gray-500">Has Website</div>
          <div class="text-xs text-gray-400">{Math.round((summary.hygiene.withWebsite / totalApps) * 100)}%</div>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100 text-center">
          <div class="text-2xl font-bold text-gray-900">{summary.hygiene.withReadme}</div>
          <div class="text-xs text-gray-500">Has README</div>
          <div class="text-xs text-gray-400">{Math.round((summary.hygiene.withReadme / totalApps) * 100)}%</div>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100 text-center">
          <div class="text-2xl font-bold text-gray-900">{summary.hygiene.withImage}</div>
          <div class="text-xs text-gray-500">README Image</div>
          <div class="text-xs text-gray-400">{Math.round((summary.hygiene.withImage / totalApps) * 100)}%</div>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100 text-center">
          <div class="text-2xl font-bold text-gray-900">{summary.hygiene.withVideo}</div>
          <div class="text-xs text-gray-500">README Video</div>
          <div class="text-xs text-gray-400">{Math.round((summary.hygiene.withVideo / totalApps) * 100)}%</div>
        </div>
      </div>

      <!-- Per-App Hygiene Table -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-visible">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center group">
                    App
                    <span class="pointer-events-none absolute left-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      GitHub repository
                    </span>
                  </span>
                </th>
                <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center justify-center group">
                    Desc
                    <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      Has GitHub description
                    </span>
                  </span>
                </th>
                <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center justify-center group">
                    Web
                    <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      Has website/homepage set
                    </span>
                  </span>
                </th>
                <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center justify-center group">
                    README
                    <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      Has README file
                    </span>
                  </span>
                </th>
                <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center justify-center group">
                    Image
                    <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      README includes an image
                    </span>
                  </span>
                </th>
                <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center justify-center group">
                    Video
                    <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      README includes a video/gif
                    </span>
                  </span>
                </th>
                <th class="text-right px-4 py-3 text-sm font-semibold text-gray-700">
                  <span class="relative inline-flex items-center justify-end group">
                    Stars
                    <span class="pointer-events-none absolute right-0 bottom-full z-20 mb-2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                      GitHub stars
                    </span>
                  </span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {sortedApps.map((app) => app.hygiene && (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3">
                    <a href={app.github} class="text-orange-600 hover:underline font-medium" target="_blank" rel="noopener">
                      {app.name}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-center">
                    {app.hygiene.hasDescription && (
                      <span class="relative inline-flex items-center justify-center group" aria-label="Has description">
                        <Icon name="lucide:check" class="w-4 h-4 text-green-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          Has GitHub description
                        </span>
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-center">
                    {app.hygiene.hasWebsite && (
                      <span class="relative inline-flex items-center justify-center group" aria-label="Has website">
                        <Icon name="lucide:check" class="w-4 h-4 text-green-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          Has website/homepage
                        </span>
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-center">
                    {app.hygiene.hasReadme && (
                      <span class="relative inline-flex items-center justify-center group" aria-label="Has README">
                        <Icon name="lucide:check" class="w-4 h-4 text-green-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          README exists
                        </span>
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-center">
                    {app.hygiene.readmeHasImage && (
                      <span class="relative inline-flex items-center justify-center group" aria-label="README has image">
                        <Icon name="lucide:check" class="w-4 h-4 text-green-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          README includes an image
                        </span>
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-center">
                    {app.hygiene.readmeHasVideo && (
                      <span class="relative inline-flex items-center justify-center group" aria-label="README has video">
                        <Icon name="lucide:check" class="w-4 h-4 text-green-500 inline" />
                        <span class="pointer-events-none absolute left-1/2 bottom-full z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-xs text-white opacity-0 shadow group-hover:opacity-100">
                          README includes a video/gif
                        </span>
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-right text-sm text-gray-600">{app.hygiene.stars}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Contributors -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Contributors</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
      {sortedAuthors.map((author) => (
        <a 
          href={`https://github.com/${author.github}`}
          class="bg-white rounded-lg p-4 shadow-sm border border-gray-100 hover:border-orange-200 hover:shadow transition-all text-center"
          target="_blank"
          rel="noopener"
        >
          <img 
            src={author.avatar} 
            alt={author.github}
            class="w-12 h-12 rounded-full mx-auto mb-2"
            loading="lazy"
          />
          <div class="text-sm font-medium text-gray-900 truncate">{author.github}</div>
          <div class="text-xs text-gray-500">{author.count} app{author.count > 1 ? 's' : ''}</div>
        </a>
      ))}
    </div>
  </section>

  <p class="text-center text-gray-400 text-sm">
    Last updated: {lastUpdated}
  </p>
</Layout>
