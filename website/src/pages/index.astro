---
import Layout from '../layouts/Layout.astro';
import CloudflareProduct from '../components/CloudflareProduct.astro';
import { Icon } from 'astro-icon/components';
import data from '../data.json';
import { getAppScores, getPopularityMax, getQualityMaxPoints } from '../lib/scores';
import type { AppsData } from '../../../schema';

const { apps, summary, lastUpdated, totalApps, cloudflareCatalog } = data as unknown as AppsData;
const baseUrl = import.meta.env.BASE_URL;
const popularityMax = getPopularityMax(apps);

const appsWithScores = apps.map((app) => ({
  ...app,
  scores: getAppScores(app, popularityMax),
}));

const sortedApps = [...appsWithScores].sort(
  (a, b) => b.scores.popularity - a.scores.popularity
);

const leaderboardRows = sortedApps.map((app, index) => ({
  ...app,
  rank: index + 1,
}));

const qualityMaxPoints = getQualityMaxPoints();

const shortDescription = (description: string | undefined | null) => {
  if (!description) {
    return '';
  }

  const trimmed = description.trim();
  const firstSentence = trimmed.split(/(?<=[.!?])\s/)[0];
  const maxLength = 60;

  if (firstSentence.length > maxLength) {
    return `${firstSentence.slice(0, maxLength).trim()}…`;
  }

  return firstSentence;
};

const statusIconName = (value: boolean) => (value ? 'lucide:check' : 'lucide:x');
const statusIconClass = (value: boolean) => (value ? 'text-green-500' : 'text-red-400');
const statusTooltip = (value: boolean, yesLabel: string, noLabel: string) => (value ? yesLabel : noLabel);

// Get sorted products by frequency
const sortedProducts = Object.entries(summary.cloudflareProducts)
  .sort((a, b) => b[1] - a[1]);

// Products missing from Garden
const productsInGarden = new Set(Object.keys(summary.cloudflareProducts));
const opportunityPriority = [
  "Sandbox SDK",
  "Stream",
  "Turnstile",
  "Vectorize",
  "Agents",
  "AI Search",
  "AI Gateway",
  "Browser Rendering",
  "Containers",
  "Queues",
  "R2",
  "Workers AI",
  "Workflows",
  "D1",
  "Pages",
];
const missingProducts = cloudflareCatalog
  .filter((product) => !productsInGarden.has(product.name))
  .sort((a, b) => {
    const aPriority = opportunityPriority.indexOf(a.name);
    const bPriority = opportunityPriority.indexOf(b.name);
    if (aPriority !== -1 || bPriority !== -1) {
      const aRank = aPriority === -1 ? Number.POSITIVE_INFINITY : aPriority;
      const bRank = bPriority === -1 ? Number.POSITIVE_INFINITY : bPriority;
      return aRank - bRank;
    }
    return a.name.localeCompare(b.name);
  });
---

<Layout title="Small App Garden">
  <header class="mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Small App Garden</h1>
    <p class="text-xl text-gray-600 mb-6">
      A curated collection of <strong class="text-orange-600">{totalApps} apps</strong> built on Cloudflare's developer platform.
    </p>
  </header>

  <!-- Leaderboard -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Leaderboard</h2>
    <p class="text-sm text-gray-600 mb-4">Default ranking uses popularity score (forks weighted higher than stars, 80/20). Use the toggle to sort by quality.</p>

    <div class="flex flex-wrap gap-3 mb-4">
      <button
        class="score-toggle flex items-center gap-2 px-4 py-2 rounded-full border border-orange-200 text-orange-600 bg-orange-50 text-sm font-medium"
        data-sort="popularity"
        type="button"
        aria-pressed="true"
      >
        <span class="w-2 h-2 rounded-full bg-orange-500"></span>
        Popularity
      </button>
      <button
        class="score-toggle flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 text-gray-700 bg-white text-sm font-medium"
        data-sort="quality"
        type="button"
        aria-pressed="false"
      >
        <span class="w-2 h-2 rounded-full bg-gray-300"></span>
        Quality
      </button>
      <span class="text-xs text-gray-500 self-center">
        Quality max: {qualityMaxPoints} points
      </span>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">App</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Popularity score">Popularity</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Quality score">Quality</th>
              <th class="text-right px-4 py-3 text-sm font-semibold text-gray-700" title="GitHub stars">Stars</th>
              <th class="text-right px-4 py-3 text-sm font-semibold text-gray-700" title="GitHub forks">Forks</th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Stack</th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Products</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100" id="leaderboard-body">
            {leaderboardRows.map((app, index) => (
              <tr
                class="hover:bg-gray-50"
                data-popularity={app.scores.popularity}
                data-quality={app.scores.quality}
                data-index={index}
              >
                <td class="px-4 py-3">
                  <a
                    href={`${baseUrl}apps/${app.slug}/`}
                    class="text-orange-600 hover:underline font-medium"
                  >
                    <span class="rank-badge inline-flex items-center justify-center w-6 h-6 rounded-full bg-orange-50 text-orange-600 text-xs font-semibold mr-2">{app.rank}</span>
                    {app.name}
                  </a>
                  <p class="text-xs text-gray-500 mt-1">{shortDescription(app.description)}</p>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-800 font-semibold">{app.scores.popularity}</td>
                <td class="px-4 py-3 text-center text-sm text-gray-800 font-semibold">{app.scores.quality}</td>
                <td class="px-4 py-3 text-right text-sm text-gray-600">{app.hygiene?.stars ?? 0}</td>
                <td class="px-4 py-3 text-right text-sm text-gray-600">{app.hygiene?.forks ?? 0}</td>
                <td class="px-4 py-3 text-sm text-gray-600">
                  {typeof app.stack.framework === 'string' ? app.stack.framework.replace(/\s+\d+$/, '') : 'Multiple'}
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-1 flex-nowrap whitespace-nowrap">
                    {app.cloudflare.products.map((product) => (
                      <CloudflareProduct product={product} />
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script>
    type SortKey = 'popularity' | 'quality';

    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.score-toggle')
    );
    const tbody = document.getElementById('leaderboard-body') as HTMLTableSectionElement | null;

    const applySort = (sortKey: SortKey) => {
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
      rows.sort((a, b) => {
        const aValue = Number(a.dataset[sortKey] || 0);
        const bValue = Number(b.dataset[sortKey] || 0);
        return bValue - aValue;
      });
      rows.forEach((row, index) => {
        const badge = row.querySelector<HTMLElement>('.rank-badge');
        if (badge) {
          badge.textContent = `${index + 1}`;
        }
        tbody.appendChild(row);
      });
    };

    const updateButtonStyles = (activeKey: SortKey) => {
      buttons.forEach((button) => {
        const isActive = button.dataset.sort === activeKey;
        button.className = `score-toggle flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-medium ${
          isActive
            ? 'border-orange-200 text-orange-600 bg-orange-50'
            : 'border-gray-200 text-gray-700 bg-white'
        }`;
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        const dot = button.querySelector('span');
        if (dot) {
          dot.className = `w-2 h-2 rounded-full ${isActive ? 'bg-orange-500' : 'bg-gray-300'}`;
        }
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const sortKey = (button.dataset.sort as SortKey | undefined) ?? 'popularity';
        applySort(sortKey);
        updateButtonStyles(sortKey);
      });
    });
  </script>

  <!-- Cloudflare Products & Opportunities (grouped together) -->
  <div class="grid md:grid-cols-2 gap-8 mb-12 items-stretch">
    <!-- Cloudflare Products -->
    <section class="flex flex-col h-full">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Covered Products</h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex-1">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Product</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">Count</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedProducts.map(([product, count]) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <CloudflareProduct product={product} />
                    <span class="text-sm text-gray-700">{product}</span>
                  </div>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-600">{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Opportunities -->
    <section class="flex flex-col h-full">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Opportunities</h2>
      <p class="text-sm text-gray-600 mb-4">Cloudflare products not yet represented in the Garden:</p>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex-1">
        <div class="divide-y divide-gray-100 h-full overflow-y-auto">
          {missingProducts.map((product) => (
            <div class="px-4 py-3 hover:bg-gray-50">
              <a 
                href={`https://developers.cloudflare.com/${product.slug}`}
                class="font-medium text-orange-600 hover:underline"
                target="_blank"
                rel="noopener"
              >
                {product.name}
              </a>
              {product.description && <p class="text-sm text-gray-600">{product.description}</p>}
              {product.ideas && <p class="text-xs text-gray-400 mt-1">Ideas: {product.ideas}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>



  <p class="text-center text-gray-400 text-sm">
    Last updated: {lastUpdated}
  </p>
</Layout>
