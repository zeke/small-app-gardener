---
import Layout from '../layouts/Layout.astro';
import CloudflareProduct from '../components/CloudflareProduct.astro';
import { Icon } from 'astro-icon/components';
import data from '../data.json';
import { getAppScores, getPopularityMax } from '../lib/scores';

const { apps, summary, lastUpdated, totalApps, cloudflareCatalog } = data;
const baseUrl = import.meta.env.BASE_URL;
const popularityMax = getPopularityMax(apps);

const appsWithScores = apps.map((app) => ({
  ...app,
  scores: getAppScores(app, popularityMax),
}));

const sortedApps = [...appsWithScores].sort(
  (a, b) => b.scores.popularity - a.scores.popularity
);

const leaderboardRows = sortedApps.map((app, index) => ({
  ...app,
  rank: index + 1,
}));


const shortDescription = (description: string | undefined | null) => {
  if (!description) {
    return '';
  }

  const trimmed = description.trim();
  const firstSentence = trimmed.split(/(?<=[.!?])\s/)[0];
  const maxLength = 60;

  if (firstSentence.length > maxLength) {
    return `${firstSentence.slice(0, maxLength).trim()}…`;
  }

  return firstSentence;
};

const statusIconName = (value: boolean) => (value ? 'lucide:check' : 'lucide:x');
const statusIconClass = (value: boolean) => (value ? 'text-green-500' : 'text-red-400');
const statusTooltip = (value: boolean, yesLabel: string, noLabel: string) => (value ? yesLabel : noLabel);

// Get sorted products by frequency
const sortedProducts = Object.entries(summary.cloudflareProducts)
  .sort((a, b) => b[1] - a[1]);

// Products missing from Garden
const productsInGarden = new Set(Object.keys(summary.cloudflareProducts));
const opportunityPriority = [
  "Sandbox SDK",
  "Stream",
  "Turnstile",
  "Vectorize",
  "Agents",
  "AI Search",
  "AI Gateway",
  "Browser Rendering",
  "Containers",
  "Queues",
  "R2",
  "Workers AI",
  "Workflows",
  "D1",
  "Pages",
];
const missingProducts = cloudflareCatalog
  .filter((product) => !productsInGarden.has(product.name))
  .sort((a, b) => {
    const aPriority = opportunityPriority.indexOf(a.name);
    const bPriority = opportunityPriority.indexOf(b.name);
    if (aPriority !== -1 || bPriority !== -1) {
      const aRank = aPriority === -1 ? Number.POSITIVE_INFINITY : aPriority;
      const bRank = bPriority === -1 ? Number.POSITIVE_INFINITY : bPriority;
      return aRank - bRank;
    }
    return a.name.localeCompare(b.name);
  });
---

<Layout title="Gardener">
  <header class="mb-12 text-center">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">👩‍🌾 Gardener</h1>
    <p class="text-xl text-gray-600 mb-6">
      A leaderboard for Cloudflare's <a href="https://developers.cloudflare.com/garden/" class="text-orange-600 hover:underline" target="_blank" rel="noopener">small app garden</a>.
    </p>
  </header>

  <!-- Leaderboard -->
  <section class="mb-12">

    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">App</th>
              <th class="text-left px-4 py-3 text-sm font-semibold" aria-sort="descending" title="Popularity score">
                <button type="button" class="sort-header inline-flex items-center justify-start gap-1 cursor-pointer bg-transparent p-0 underline underline-offset-4 text-orange-700" data-sort="popularity">
                  Popularity
                  <span class="sort-indicator text-orange-400">↓</span>
                </button>
              </th>
              <th class="text-left px-4 py-3 text-sm font-semibold" aria-sort="none" title="Quality score">
                <button type="button" class="sort-header inline-flex items-center justify-start gap-1 cursor-pointer bg-transparent p-0 text-gray-700 hover:text-gray-900 hover:underline hover:underline-offset-4" data-sort="quality">
                  Quality
                  <span class="sort-indicator"></span>
                </button>
              </th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Products</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100" id="leaderboard-body">
            {leaderboardRows.map((app, index) => (
              <tr
                class="hover:bg-gray-50"
                data-popularity={app.scores.popularity}
                data-quality={app.scores.quality}
                data-index={index}
              >
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <span class="rank-badge inline-flex items-center justify-center w-6 h-6 rounded-full bg-orange-50 text-orange-600 text-xs font-semibold tabular-nums">
                      {app.rank}
                    </span>
                    <div class="min-w-0">
                      <a
                        href={`${baseUrl}apps/${app.slug}/`}
                        class="text-orange-600 hover:underline font-medium"
                      >
                        {app.name}
                      </a>
                      <p class="text-xs text-gray-500 mt-1">{shortDescription(app.description)}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-left">
                  <div class="flex items-center justify-start gap-3">
                    <span class="text-2xl font-semibold text-gray-900 tabular-nums">{app.scores.popularity}</span>
                    <span class="flex items-center gap-2 text-xs text-gray-400">
                      <span class="inline-flex items-center gap-1">
                        <Icon name="lucide:star" class="w-3.5 h-3.5" />
                        {app.hygiene?.stars ?? 0}
                      </span>
                      <span class="inline-flex items-center gap-1">
                        <Icon name="lucide:git-fork" class="w-3.5 h-3.5" />
                        {app.hygiene?.forks ?? 0}
                      </span>
                    </span>
                  </div>
                </td>
                <td class="px-4 py-3 text-left">
                  <span class="text-2xl font-semibold text-gray-900 tabular-nums">{app.scores.quality}</span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-1 flex-nowrap whitespace-nowrap">
                    {app.cloudflare.products.map((product) => (
                      <CloudflareProduct product={product} />
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script>
    type SortKey = 'popularity' | 'quality';

    const sortButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.sort-header')
    );
    const tbody = document.getElementById('leaderboard-body') as HTMLTableSectionElement | null;

    const applySort = (sortKey: SortKey) => {
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
      rows.sort((a, b) => {
        const aValue = Number(a.dataset[sortKey] || 0);
        const bValue = Number(b.dataset[sortKey] || 0);
        return bValue - aValue;
      });
      rows.forEach((row, index) => {
        const badge = row.querySelector<HTMLElement>('.rank-badge');
        if (badge) {
          badge.textContent = `${index + 1}`;
        }
        tbody.appendChild(row);
      });
    };

    const updateSortHeaders = (activeKey: SortKey) => {
      sortButtons.forEach((button) => {
        const sortKey = button.dataset.sort as SortKey | undefined;
        const th = button.closest('th');
        const indicator = button.querySelector<HTMLElement>('.sort-indicator');
        const isActive = sortKey === activeKey;

        if (isActive) {
          button.className = 'sort-header inline-flex items-center justify-start gap-1 cursor-pointer bg-transparent p-0 underline underline-offset-4 text-orange-700';
          if (th) th.setAttribute('aria-sort', 'descending');
          if (indicator) {
            indicator.textContent = '↓';
            indicator.className = 'sort-indicator text-orange-400';
          }
        } else {
          button.className = 'sort-header inline-flex items-center justify-start gap-1 cursor-pointer bg-transparent p-0 text-gray-700 hover:text-gray-900 hover:underline hover:underline-offset-4';
          if (th) th.setAttribute('aria-sort', 'none');
          if (indicator) {
            indicator.textContent = '';
            indicator.className = 'sort-indicator';
          }
        }
      });
    };

    sortButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const sortKey = (button.dataset.sort as SortKey | undefined) ?? 'popularity';
        applySort(sortKey);
        updateSortHeaders(sortKey);
      });
    });

    applySort('popularity');
    updateSortHeaders('popularity');
  </script>

  <!-- Cloudflare Products & Opportunities (grouped together) -->
  <div class="grid md:grid-cols-2 gap-8 mb-12 items-stretch">
    <!-- Cloudflare Products -->
    <section class="flex flex-col h-full">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Covered Products</h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex-1">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Product</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">Count</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedProducts.map(([product, count]) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <CloudflareProduct product={product} />
                    <span class="text-sm text-gray-700">{product}</span>
                  </div>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-600">{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Opportunities -->
    <section class="flex flex-col h-full">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Opportunities</h2>
      <p class="text-sm text-gray-600 mb-4">Cloudflare products not yet represented in the Garden:</p>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex-1">
        <div class="divide-y divide-gray-100 h-full overflow-y-auto">
          {missingProducts.map((product) => (
            <div class="px-4 py-3 hover:bg-gray-50">
              <a 
                href={`https://developers.cloudflare.com/${product.slug}`}
                class="font-medium text-orange-600 hover:underline"
                target="_blank"
                rel="noopener"
              >
                {product.name}
              </a>
              {product.description && <p class="text-sm text-gray-600">{product.description}</p>}
              {product.ideas && <p class="text-xs text-gray-400 mt-1">Ideas: {product.ideas}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>



  <p class="text-center text-gray-400 text-sm">
    Last updated: {lastUpdated}
  </p>
</Layout>
