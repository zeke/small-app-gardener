---
import Layout from '../layouts/Layout.astro';
import CloudflareProduct from '../components/CloudflareProduct.astro';
import { Icon } from 'astro-icon/components';
import data from '../data.json';

const { apps, summary, lastUpdated, totalApps, cloudflareCatalog } = data;

// Sort apps by shipped date (newest first)
const sortedApps = [...apps].sort(
  (a, b) => new Date(b.shippedDate).getTime() - new Date(a.shippedDate).getTime()
);

const shortDescription = (description) => {
  if (!description) {
    return "";
  }

  const trimmed = description.trim();
  const firstSentence = trimmed.split(/(?<=[.!?])\s/)[0];
  const maxLength = 60;

  if (firstSentence.length > maxLength) {
    return `${firstSentence.slice(0, maxLength).trim()}…`;
  }

  return firstSentence;
};

const statusIconName = (value) => (value ? "lucide:check" : "lucide:x");
const statusIconClass = (value) => (value ? "text-green-500" : "text-red-400");
const statusTooltip = (value, yesLabel, noLabel) => (value ? yesLabel : noLabel);

// Get sorted products by frequency
const sortedProducts = Object.entries(summary.cloudflareProducts)
  .sort((a, b) => b[1] - a[1]);

// Products missing from Garden
const productsInGarden = new Set(Object.keys(summary.cloudflareProducts));
const opportunityPriority = [
  "Sandbox SDK",
  "Stream",
  "Turnstile",
  "Vectorize",
  "Agents",
  "AI Search",
  "AI Gateway",
  "Browser Rendering",
  "Containers",
  "Queues",
  "R2",
  "Workers AI",
  "Workflows",
  "D1",
  "Pages",
];
const missingProducts = cloudflareCatalog
  .filter((product) => !productsInGarden.has(product.name))
  .sort((a, b) => {
    const aPriority = opportunityPriority.indexOf(a.name);
    const bPriority = opportunityPriority.indexOf(b.name);
    if (aPriority !== -1 || bPriority !== -1) {
      const aRank = aPriority === -1 ? Number.POSITIVE_INFINITY : aPriority;
      const bRank = bPriority === -1 ? Number.POSITIVE_INFINITY : bPriority;
      return aRank - bRank;
    }
    return a.name.localeCompare(b.name);
  });
---

<Layout title="Small App Garden">
  <header class="mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Small App Garden</h1>
    <p class="text-xl text-gray-600 mb-6">
      A curated collection of <strong class="text-orange-600">{totalApps} apps</strong> built on Cloudflare's developer platform.
    </p>
  </header>

  <!-- Apps + Hygiene Table -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Apps</h2>
    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">App</th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Stack</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Has tests">Tests</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Has CI">CI</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Has description">Desc</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Has website">Web</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="Has README">README</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="README has image">Image</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700" title="README has video">Video</th>
              <th class="text-right px-4 py-3 text-sm font-semibold text-gray-700" title="GitHub stars">Stars</th>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Products</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedApps.map((app) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <a href={app.github} class="text-orange-600 hover:underline font-medium" target="_blank" rel="noopener">
                    {app.name}
                  </a>
                  <p class="text-xs text-gray-500 mt-1">{shortDescription(app.description)}</p>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600">
                  {typeof app.stack.framework === 'string' ? app.stack.framework.replace(/\s+\d+$/, '') : 'Multiple'}
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.testing.hasTests)}`}>
                    <Icon name={statusIconName(app.testing.hasTests)} class="w-5 h-5" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.testing.hasTests, "Has tests", "No tests detected")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.ci.hasGitHubActions)}`}>
                    <Icon name={statusIconName(app.ci.hasGitHubActions)} class="w-5 h-5" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.ci.hasGitHubActions, "Has CI", "No CI detected")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.hygiene?.hasDescription)}`}>
                    <Icon name={statusIconName(app.hygiene?.hasDescription)} class="w-4 h-4" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.hygiene?.hasDescription, "Has description", "No description")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.hygiene?.hasWebsite)}`}>
                    <Icon name={statusIconName(app.hygiene?.hasWebsite)} class="w-4 h-4" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.hygiene?.hasWebsite, "Has website", "No website")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.hygiene?.hasReadme)}`}>
                    <Icon name={statusIconName(app.hygiene?.hasReadme)} class="w-4 h-4" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.hygiene?.hasReadme, "Has README", "No README")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.hygiene?.readmeHasImage)}`}>
                    <Icon name={statusIconName(app.hygiene?.readmeHasImage)} class="w-4 h-4" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.hygiene?.readmeHasImage, "README has image", "No README image")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class={`relative group inline-flex ${statusIconClass(app.hygiene?.readmeHasVideo)}`}>
                    <Icon name={statusIconName(app.hygiene?.readmeHasVideo)} class="w-4 h-4" />
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      {statusTooltip(app.hygiene?.readmeHasVideo, "README has video", "No README video")}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-right text-sm text-gray-600" title="GitHub stars">{app.hygiene?.stars ?? 0}</td>
                <td class="px-4 py-3">
                  <div class="flex gap-1 flex-nowrap whitespace-nowrap">
                    {app.cloudflare.products.map((product) => (
                      <CloudflareProduct product={product} />
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Cloudflare Products & Opportunities (grouped together) -->
  <div class="grid md:grid-cols-2 gap-8 mb-12 items-stretch">
    <!-- Cloudflare Products -->
    <section class="flex flex-col h-full">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Covered Products</h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex-1">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 text-sm font-semibold text-gray-700">Product</th>
              <th class="text-center px-4 py-3 text-sm font-semibold text-gray-700">Count</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {sortedProducts.map(([product, count]) => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <CloudflareProduct product={product} />
                    <span class="text-sm text-gray-700">{product}</span>
                  </div>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-600">{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Opportunities -->
    <section class="flex flex-col h-full">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Opportunities</h2>
      <p class="text-sm text-gray-600 mb-4">Cloudflare products not yet represented in the Garden:</p>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex-1">
        <div class="divide-y divide-gray-100 h-full overflow-y-auto">
          {missingProducts.map((product) => (
            <div class="px-4 py-3 hover:bg-gray-50">
              <a 
                href={`https://developers.cloudflare.com/${product.slug}`}
                class="font-medium text-orange-600 hover:underline"
                target="_blank"
                rel="noopener"
              >
                {product.name}
              </a>
              {product.description && <p class="text-sm text-gray-600">{product.description}</p>}
              {product.ideas && <p class="text-xs text-gray-400 mt-1">Ideas: {product.ideas}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>



  <p class="text-center text-gray-400 text-sm">
    Last updated: {lastUpdated}
  </p>
</Layout>
